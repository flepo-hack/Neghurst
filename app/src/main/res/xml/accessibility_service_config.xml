<?xml version="1.0" encoding="utf-8"?>
<!--
  `accessibilityEventTypes` is deliberately empty.

  The previous config requested `typeWindowStateChanged|typeWindowContentChanged`.
  A running game emits `typeWindowContentChanged` continuously as its HUD
  updates, which floods the service with thousands of events per second. That is
  a well known cause of AccessibilityService ANRs and, more importantly here, of
  gesture dispatch being delayed by tens of milliseconds. Rendera only ever
  *dispatches* gestures, it never inspects the UI, so it needs no events at all.

  `canRetrieveWindowContent` is off for the same reason: nothing reads window
  content, and requesting it adds latency and review friction for no benefit.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes=""
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.example.MainActivity" />
